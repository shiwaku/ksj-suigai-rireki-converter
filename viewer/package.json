{
  "name": "ksj-suigai-rireki-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "国土数値情報 水害履歴(浸水実績)のベクトルタイルを Mapterhorn 地形とあわせて表示する Web ビューワ",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run check:style && npm run check:search && npm run check:relief && npm run export:style && vite build",
    "preview": "vite preview",
    "check:style": "node scripts/check-style.mjs",
    "check:search": "node scripts/check-search.mjs",
    "check:relief": "node scripts/check-relief.mjs",
    "export:style": "node scripts/export-style.mjs"
  },
  "dependencies": {
    "maplibre-contour": "0.0.5",
    "maplibre-gl": "5.6.0",
    "pmtiles": "4.3.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^23.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  }
}
